{
  "name": "pi-telegram-operator",
  "version": "1.0.0",
  "description": "TelegraPi: a threaded Telegram operator for Pi sessions",
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "daemon.cjs",
    "daemon-windows.vbs",
    "service.cjs",
    "setup.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cjs.json",
    "syntax": "node scripts/check-syntax.cjs",
    "check": "npm run typecheck && npm run syntax && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "telegram",
    "notifications",
    "streaming",
    "threads"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnsonRan/pi-telegram-operator.git"
  },
  "bugs": {
    "url": "https://github.com/JohnsonRan/pi-telegram-operator/issues"
  },
  "homepage": "https://github.com/JohnsonRan/pi-telegram-operator#readme",
  "dependencies": {
    "typebox": "^1.3.7"
  }
}
